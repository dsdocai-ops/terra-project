    {
      "name": "plain_hit_no_stats",
      "attacker_base": { "MAX_HP": 100.0, "ATTACK": 100.0, "DEFENSE": 0.0, "MOVE_SPEED": 120.0, "ATTACK_SPEED": 1.0, "DODGE_COOLDOWN": 0.8, "CRIT_CHANCE": 0.0, "CRIT_DAMAGE": 0.0, "ABILITY_POWER": 100.0, "COOLDOWN_REDUCTION": 0.0, "LUCK": 0.0 },
      "target_base": { "MAX_HP": 100.0, "ATTACK": 10.0, "DEFENSE": 0.0, "MOVE_SPEED": 80.0, "ATTACK_SPEED": 1.0, "DODGE_COOLDOWN": 0.8, "CRIT_CHANCE": 0.0, "CRIT_DAMAGE": 0.0, "ABILITY_POWER": 100.0, "COOLDOWN_REDUCTION": 0.0, "LUCK": 0.0 },
      "hit": { "base_damage": 20.0, "multiplier": 1.0, "bonus_crit_chance": 0.0, "element": "NONE", "tags": ["melee"] },
      "expected": 20
    },
