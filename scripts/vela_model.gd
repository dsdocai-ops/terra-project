extends Node3D
## Vela mech: instances a rigged Vela model (model_scene: Vela-08 for the player by default;
## enemy.gd uses Vela-07), plays its Idle / Run / Fly / Hover / Cruise clips from the owner's
## state, flares the back plates in the air, drives the thruster flames and aims the right arm
## cannon (aim_arm / fire_recoil, via arm_aim.gd). Its materials are cel-shaded with an ink
## outline at runtime to match the toon world, and hit_flash() flashes them when it's shot.
## explode() blows it apart (a flash, a fireball, parts flying off as debris); reassemble() rebuilds it.
## Faces -Z (Godot forward). Feet at y = 0. Both models and their clips are generated by
## art_src/vela_07/build_vela_07.py (palette=vela_07 / vela_08).

const VELA_07 := preload("res://assets/models/vela_07.glb")
const VELA_08 := preload("res://assets/models/vela_08.glb")
const HIT_FLASH_COLOR := Color(1.0, 0.85, 0.6)
const HIT_FLASH_TIME := 0.15
const Thruster := preload("res://scripts/thruster.gd")
const ArmAim := preload("res://scripts/arm_aim.gd")
const ToonFx := preload("res://scripts/toon_fx.gd")
const AIM_BLEND_SPEED := 6.0              # how quickly the cannon arm raises / lowers (eased; 1/6 s)
const RECOIL_RECOVERY := 5.0              # how quickly the arm settles after a shot (per second)
const OUTLINE_SHADER := preload("res://shaders/outline.gdshader")
const OUTLINE_WIDTH := 0.012              # ink outline thickness (m), to match the toon world
const BLEND_TIME := 0.25
const RUN_ANIM_SPEED := 9.0               # ground speed (m/s) the run cycle matches at normal playback
const PLATE_FLARE := deg_to_rad(25.0)     # how far the back plates swing out in the air

const MechExplosion := preload("res://scripts/mech_explosion.gd")
const OVERLOAD_TIME := 0.15               # a flash of the armour just before the mech blows up
const DEBRIS_LIFE := 2.6                  # how long the scattered parts tumble before shrinking away

## Emitted the moment the mech blows apart (just after the flash), e.g. to shake the camera.
signal exploded

## Which mech to show. Set it before the node enters the tree.
@export var model_scene: PackedScene = VELA_08

var _mech: Node3D
var _parts: Array[MeshInstance3D] = []    # the model's part meshes (what flies apart in explode())
var _wrecked := false
var _blue := false                        # blue thruster / muzzle particles (the player's Vela-08)
var _anim: AnimationPlayer
var _skeleton: Skeleton3D
var _backpack := -1
var _backpack_rest: Quaternion
var _flare_axis: Vector3                  # skeleton-space X, expressed in the Backpack bone's frame
var _spread := 0.0
var _flap_time := 0.0
var _thrusters: Array[Thruster] = []
var _flame_light: OmniLight3D
var _arm_aim: ArmAim
var _muzzle: BoneAttachment3D
var _muzzle_sparks: CPUParticles3D
var _armor_mats: Array[BaseMaterial3D] = []  # non-glowing toon materials, flashed by hit_flash()
var _aim_blend := 0.0                     # linear 0..1 behind the eased arm-aim influence


func _ready() -> void:
	_assemble()


## Blows the mech up: its armour flashes, then it explodes
## (mech_explosion.gd) and every part flies off as tumbling debris that shrinks away.
## The mech stays hidden until reassemble().
func explode() -> void:
	if _wrecked:
		return
	_wrecked = true
	set_thrust(0.0)
	_arm_aim.influence = 0.0
	_aim_blend = 0.0
	hit_flash()
	create_tween().tween_callback(_blow_apart).set_delay(OVERLOAD_TIME)


## Rebuilds the mech after explode() (e.g. on respawn).
func reassemble() -> void:
	remove_child(_mech)
	_mech.queue_free()
	_flame_light.queue_free()
	_thrusters.clear()
	_armor_mats.clear()
	_parts.clear()
	_spread = 0.0
	_aim_blend = 0.0
	_wrecked = false
	_assemble()


func _assemble() -> void:
	_blue = model_scene == VELA_08
	var mech := model_scene.instantiate() as Node3D
	mech.rotation.y = PI  # glTF models face +Z; the player expects -Z
	add_child(mech)
	_mech = mech
	for mi: MeshInstance3D in mech.find_children("*", "MeshInstance3D", true, false):
		_parts.append(mi)
	_anim = mech.find_children("*", "AnimationPlayer", true, false).front()
	_skeleton = mech.find_children("*", "Skeleton3D", true, false).front()
	for clip in _anim.get_animation_list():
		_anim.get_animation(clip).loop_mode = Animation.LOOP_LINEAR
	_anim.play("Idle")
	_backpack = _skeleton.find_bone("Backpack")
	_backpack_rest = _skeleton.get_bone_rest(_backpack).basis.get_rotation_quaternion()
	_flare_axis = (_skeleton.get_bone_global_rest(_backpack).basis.inverse() * Vector3.RIGHT).normalized()
	_toonify(mech)
	_build_thrusters()
	_build_cannon()


## Cel-shades the imported materials and adds an ink outline so the mech matches the toon world.
## Works on copies, so the .glb itself is unchanged.
func _toonify(mech: Node) -> void:
	var outline := ShaderMaterial.new()
	outline.shader = OUTLINE_SHADER
	outline.set_shader_parameter("width", OUTLINE_WIDTH)
	var copies := {}  # source material -> its toon copy, shared by every surface that uses it
	for mi: MeshInstance3D in mech.find_children("*", "MeshInstance3D", true, false):
		for s in mi.mesh.get_surface_count():
			var source := mi.get_active_material(s) as BaseMaterial3D
			if source == null:
				continue
			if not copies.has(source):
				var copy := source.duplicate() as BaseMaterial3D
				copy.diffuse_mode = BaseMaterial3D.DIFFUSE_TOON
				copy.specular_mode = BaseMaterial3D.SPECULAR_TOON
				copy.metallic = minf(copy.metallic, 0.2)  # metal reads as dark under toon shading
				copy.next_pass = outline
				copies[source] = copy
				if not copy.emission_enabled:
					_armor_mats.append(copy)
			mi.set_surface_override_material(s, copies[source])


## Flashes the armour bright for a moment, e.g. when hit by a shot.
func hit_flash() -> void:
	for mat in _armor_mats:
		mat.emission_enabled = true
		mat.emission = HIT_FLASH_COLOR
		mat.emission_energy_multiplier = 2.0
		create_tween().tween_property(mat, "emission_energy_multiplier", 0.0, HIT_FLASH_TIME)


## Raises the right arm cannon to point at `target` (global) while `active`, and lowers it
## back into the current animation when not. Call every frame.
func aim_arm(target: Vector3, active: bool, delta: float) -> void:
	_arm_aim.target = target
	_aim_blend = move_toward(_aim_blend, 1.0 if active else 0.0, AIM_BLEND_SPEED * delta)
	_arm_aim.influence = smoothstep(0.0, 1.0, _aim_blend)  # eases in and out instead of a linear swing
	_arm_aim.recoil = move_toward(_arm_aim.recoil, 0.0, RECOIL_RECOVERY * delta)


## Kicks the cannon arm back and sprays sparkles from the muzzle. Call when a shot is fired.
## (No flash ball here: the shot itself grows out of the barrel, so firing shows one ball.)
func fire_recoil() -> void:
	_arm_aim.recoil = 1.0
	_muzzle_sparks.restart()


## Global transform at the cannon's muzzle (origin at the tip, +Y along the barrel).
func muzzle_transform() -> Transform3D:
	return _muzzle.global_transform


## Picks the clip for the player's state and syncs the run cycle to ground speed.
## hovering: holding position in the air (stabilising, or barely moving).
func update_motion(on_floor: bool, ground_speed: float, cruising: bool, hovering := false) -> void:
	var clip := "Idle"
	var speed := 1.0
	if cruising:
		clip = "Cruise"
	elif not on_floor:
		clip = "Hover" if hovering else "Fly"
	elif ground_speed > 1.0:
		clip = "Run"
		speed = clampf(ground_speed / RUN_ANIM_SPEED, 0.8, 2.2)
	if _anim.current_animation != clip:
		_anim.play(clip, BLEND_TIME)
	_anim.speed_scale = speed


## Swings the back plates out in the air (open 1) or folds them (open 0).
## While flapping (thrusters firing) they beat; otherwise they drift slightly.
func update_wings(open: bool, flapping: bool, delta: float) -> void:
	_spread = move_toward(_spread, 1.0 if open else 0.0, 4.0 * delta)
	_flap_time += delta * (16.0 if flapping else 4.0)
	var flap := sin(_flap_time) * (0.12 if flapping else 0.03) * _spread
	var angle := PLATE_FLARE * _spread + flap
	_skeleton.set_bone_pose_rotation(_backpack, _backpack_rest * Quaternion(_flare_axis, angle))


## Thruster power 0..1: drives the boot and back-plate jets and the flickering light under the mech.
func set_thrust(level: float) -> void:
	for thruster in _thrusters:
		thruster.set_power(level)
	_flame_light.light_energy = 6.0 * level * randf_range(0.8, 1.15)


func _build_thrusters() -> void:
	# Boot soles, plus the tips of the two back plates (positions in this node's space at rest),
	# with the jet length at full power.
	var spots := [
		["LeftFoot", Vector3(-0.31, 0.03, -0.03), 1.0], ["RightFoot", Vector3(0.31, 0.03, -0.03), 1.0],
		["Backpack", Vector3(-0.22, 1.5, 0.43), 0.7], ["Backpack", Vector3(0.22, 1.5, 0.43), 0.7],
	]
	for spot in spots:
		var thruster := Thruster.new()
		thruster.blue = _blue
		thruster.jet_length = spot[2]
		_attach(spot[0], spot[1]).add_child(thruster)
		_thrusters.append(thruster)
	_flame_light = OmniLight3D.new()
	_flame_light.position = Vector3(0, -0.3, 0)
	_flame_light.light_color = Color(0.08, 0.2, 0.75) if _blue else Color(0.55, 0.4, 1.0)
	_flame_light.omni_range = 12.0
	_flame_light.light_energy = 0.0
	add_child(_flame_light)


## Aim modifier for the right arm cannon, plus a node and flash at its muzzle.
func _build_cannon() -> void:
	_arm_aim = ArmAim.new()
	_arm_aim.influence = 0.0
	_skeleton.add_child(_arm_aim)
	_muzzle = BoneAttachment3D.new()
	_muzzle.bone_name = "RightMuzzle"
	_skeleton.add_child(_muzzle)
	# Sparkles spraying out of the barrel (+Y), left behind in the world.
	_muzzle_sparks = ToonFx.burst(8, 0.25, 0.16,
		ToonFx.sprite_material(ToonFx.Shape.SPARKLE, {"ink_width": 0.0, "energy": 2.2}),
		[[0.0, Color(0.92, 0.98, 1.0)], [0.4, Color(0.45, 0.8, 1.0)]] if _blue \
				else [[0.0, Color(1.0, 0.95, 1.0)], [0.4, Color(0.8, 0.55, 1.0)]],
		[Vector2(0.0, 1.0), Vector2(1.0, 0.0)])
	_muzzle_sparks.direction = Vector3.UP
	_muzzle_sparks.spread = 35.0
	_muzzle_sparks.initial_velocity_min = 4.0
	_muzzle_sparks.initial_velocity_max = 9.0
	_muzzle_sparks.damping_min = 10.0
	_muzzle_sparks.damping_max = 14.0
	_muzzle.add_child(_muzzle_sparks)


## Returns a node that follows `bone`, placed at `point` (this node's space, rest pose)
## with this node's orientation, so emitters fire straight down until the bone moves.
func _attach(bone: String, point: Vector3) -> Node3D:
	var attachment := BoneAttachment3D.new()
	attachment.bone_name = bone
	_skeleton.add_child(attachment)
	var in_skeleton := _skeleton.global_transform.affine_inverse() * global_transform * Transform3D(Basis.IDENTITY, point)
	var holder := Node3D.new()
	holder.transform = _skeleton.get_bone_global_rest(_skeleton.find_bone(bone)).affine_inverse() * in_skeleton
	attachment.add_child(holder)
	return holder


## The explosion proper: a fireball at the chest, and each part (with its toon material and
## outline) becomes a tumbling physics body flung away from the blast. Debris only collides
## with the world (layer 1) and nothing collides with it, so shots and players pass through.
func _blow_apart() -> void:
	var centre := _chest_position()
	var world := _world()
	var boom := MechExplosion.new()
	world.add_child(boom)
	boom.global_position = centre
	for mi in _parts:
		if not is_instance_valid(mi):
			continue
		var box := mi.get_aabb()
		var shape := BoxShape3D.new()
		shape.size = (box.size * 0.9).max(Vector3.ONE * 0.06)
		var cs := CollisionShape3D.new()
		cs.shape = shape
		cs.position = box.get_center()
		var body := RigidBody3D.new()
		body.collision_layer = 0
		body.collision_mask = 1
		body.add_child(cs)
		var xf := mi.global_transform
		world.add_child(body)
		body.global_transform = Transform3D(xf.basis.orthonormalized(), xf.origin)
		mi.reparent(body, true)
		var away := xf * box.get_center() - centre
		away = away.normalized() if away.length() > 0.01 else Vector3.UP
		body.linear_velocity = away * randf_range(5.0, 12.0) + Vector3.UP * randf_range(3.0, 8.0)
		body.angular_velocity = Vector3(randf_range(-1, 1), randf_range(-1, 1), randf_range(-1, 1)) * 10.0
		var fade := body.create_tween()
		fade.tween_interval(DEBRIS_LIFE * randf_range(0.8, 1.2))
		fade.tween_property(mi, "scale", Vector3.ONE * 0.01, 0.4)
		fade.tween_callback(body.queue_free)
	_mech.visible = false
	exploded.emit()


func _chest_position() -> Vector3:
	return _skeleton.to_global(_skeleton.get_bone_global_pose(_skeleton.find_bone("Chest")).origin)


## Where debris and the explosion go: the running scene, so they outlive this mech's motion.
func _world() -> Node:
	var scene := get_tree().current_scene
	return scene if scene != null else get_tree().root
